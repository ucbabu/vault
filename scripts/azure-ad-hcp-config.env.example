# Azure AD HCP Organization SSO Configuration Template
# Copy this file to azure-ad-hcp-config.env and modify values

# HCP Organization Configuration
HCP_ORG_ID="your-hcp-organization-id"

# Azure AD Configuration
AZURE_TENANT_ID="your-azure-tenant-id"
APP_NAME="HashiCorp Cloud Platform"

# Optional: Use existing Azure AD application
# If specified, the script will skip creating a new application
# APP_CLIENT_ID="existing-azure-app-client-id"

# Azure AD Groups Configuration
# These groups will be created in Azure AD if they don't exist
AZURE_GROUPS=(
    "HCP-Platform-Admins"
    "HCP-Vault-Admins" 
    "HCP-Vault-Operators"
    "HCP-Vault-Developers"
    "HCP-Security-Team"
)

# Group to HCP Role Mappings
# Format: "GroupName:HCPRole:Projects"
# HCP Roles: Admin, Contributor, Viewer
# Projects: Use "*" for all projects or comma-separated list
GROUP_MAPPINGS=(
    "HCP-Platform-Admins:Admin:*"
    "HCP-Vault-Admins:Admin:vault-production,vault-staging"
    "HCP-Vault-Operators:Contributor:vault-production,vault-staging"
    "HCP-Vault-Developers:Contributor:vault-development,vault-staging"
    "HCP-Security-Team:Viewer:*"
)

# SSO Configuration Options
JIT_PROVISIONING=true
ENFORCE_SSO=false

# Advanced Azure AD Configuration
CONDITIONAL_ACCESS_ENABLED=true
REQUIRE_MFA=true
TOKEN_LIFETIME="8h"
SESSION_TIMEOUT="30m"

# Test Users (for validation)
TEST_USERS=(
    "admin-user@yourdomain.com:HCP-Platform-Admins"
    "vault-admin@yourdomain.com:HCP-Vault-Admins"
    "developer@yourdomain.com:HCP-Vault-Developers"
)

# Notification Settings
NOTIFY_ON_CONFIG_CHANGE=true
NOTIFICATION_EMAIL="platform-team@yourdomain.com"

# Backup Settings
AUTO_BACKUP=true
BACKUP_RETENTION_DAYS=90